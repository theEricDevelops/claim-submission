model Tenant {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique // Company name
  subdomain String @unique
  secretKey String @unique

  members     Member[]       @relation("TenantMembers")
  admins      Member[]       @relation("TenantAdmins")
  users       User[]         @relation("TenantUsers")
  config      TenantConfig?
  tenantRoles TenantRole[]
  invites     TenantInvite[]
}

model TenantConfig {
  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  primaryColor   String
  secondaryColor String

  phoneTypes   String[] @default(["home", "work", "cell", "fax", "other"])
  emailTypes   String[] @default(["home", "work", "other"])
  addressTypes String[] @default(["home", "work", "mailing", "other"])
}

model TenantRole {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  slug String

  privileges String[]
  members    Member[]
  users      User[]
}

model TenantInvite {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email String // Not unique because more than one tenant might invite the same client/vendor user.
}
