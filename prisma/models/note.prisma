model Note {
  id String @id @default(uuid()) @db.Uuid

  noteableType NoteableType
  noteableId   String       @db.Uuid

  author   Person @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @db.Uuid

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteableType, noteableId])
  @@index([authorId])
}
