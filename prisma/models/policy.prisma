model Policy {
  id String @id @default(uuid()) @db.Uuid

  policyNumber String
  claimNumber  String?

  dateOfLoss DateTime?
  typeOfLoss String?

  deductible     Float?
  coverageLimits Json?

  carrierId String    @db.Uuid
  carrier   Company   @relation("CarrierOnPolicies", fields: [carrierId], references: [id], onDelete: Restrict)
  lender    Company[] @relation("LenderOnPolicies")

  policyEffectiveDate  DateTime?
  policyExpirationDate DateTime?

  jobs  Job[]
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId])
  @@index([policyNumber])
  @@index([claimNumber])
}
